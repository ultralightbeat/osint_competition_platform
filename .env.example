# Application
FLASK_APP=src/app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database
POSTGRES_USER=osint
POSTGRES_PASSWORD=secure-password
POSTGRES_DB=osint_platform

# Redis (optional; leave empty for local dev)
REDIS_URL=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# JWT
JWT_SECRET_KEY=jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# S3 / object storage (AWS/Beget S3-compatible)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_UPLOAD_TTL=600
S3_PRESIGNED_GET_TTL=300
TASK_IMAGE_MAX_SIZE_BYTES=10485760
TASK_IMAGE_MAX_FILES=3

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Frontend URLs
API_URL=http://localhost
WS_URL=ws://localhost

# Email (optional)
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
